{
  "name": "ai-security",
  "displayName": "AI-Security",
  "description": "AI-Security scanner for prompts, skills, MCP workflows, and agent instructions in VS Code",
  "version": "1.0.4",
  "publisher": "ai-security",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenlint.scanCurrentFile",
        "title": "AI-Security: Scan Current File"
      },
      {
        "command": "tokenlint.scanWorkspace",
        "title": "AI-Security: Scan Workspace"
      },
      {
        "command": "tokenlint.scanOrFix",
        "title": "AI-Security: Scan / Fix..."
      },
      {
        "command": "tokenlint.generateReport",
        "title": "AI-Security: Generate Report"
      },
      {
        "command": "tokenlint.showIR",
        "title": "AI-Security: Show IR"
      },
      {
        "command": "tokenlint.applyAllSafeFixes",
        "title": "AI-Security: Apply All Safe Fixes"
      },
      {
        "command": "tokenlint.showFixGraph",
        "title": "AI-Security: Show Before / After Graph"
      }
    ],
    "configuration": {
      "title": "AI-Security",
      "properties": {
        "tokenlint.maxTopK": {
          "type": "number",
          "default": 10,
          "description": "Retrieval top_k threshold"
        },
        "tokenlint.enableSecurityScanner": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI skill and prompt security scanner"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlint",
          "title": "AI-Security",
          "icon": "media/tokenlint.svg"
        }
      ]
    },
    "views": {
      "tokenlint": [
        {
          "id": "tokenlint.sidebar",
          "name": "AI-Security",
          "type": "webview",
          "icon": "media/tokenlint.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokenlint.scanCurrentFile",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@1"
        },
        {
          "command": "tokenlint.scanWorkspace",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@2"
        },
        {
          "command": "tokenlint.scanOrFix",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@3"
        },
        {
          "command": "tokenlint.applyAllSafeFixes",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@4"
        },
        {
          "command": "tokenlint.generateReport",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@5"
        },
        {
          "command": "tokenlint.showIR",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@6"
        },
        {
          "command": "tokenlint.showFixGraph",
          "when": "view == tokenlint.sidebar",
          "group": "tokenlint@7"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package",
    "release:local": "node ./scripts/release-local-extension.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
